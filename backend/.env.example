# ──────────────────────────────────────────────
# GeM-sense Backend Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ──────────────────────────────────────────────

# Cloud PostgreSQL connection string (Neon / Supabase / Railway)
# Neon example:     postgresql://alex:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Supabase example: postgresql://postgres:password@db.abcdef.supabase.co:5432/postgres?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Express server port
PORT=5000
